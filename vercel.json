{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    },
    {
      "src": "imagem/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/health",
      "dest": "main.py"
    },
    {
      "src": "/imagem/(.*)",
      "dest": "/imagem/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/$1"
    }
  ]
}